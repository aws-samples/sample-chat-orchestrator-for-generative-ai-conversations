[
  {
    "id": "info-then-price-no-repeat",
    "description": "The prospect asks for general info, then asks price. The second answer must answer price directly without repeating a full product presentation.",
    "turns": [
      {
        "message": "Bonjour, c'est quoi Miira-Cell+ ?",
        "expected": {
          "classification": {
            "primaryIntent": "information_request",
            "purchaseStage": "information",
            "shouldNotifySales": false
          },
          "policy": {
            "nextBestAction": "answer_information_then_resume_sales_flow",
            "mustAnswer": ["information"]
          },
          "response": {
            "mustInclude": ["Miira-Cell"],
            "mustExclude": ["guerit", "guerison totale", "soigne definitivement"]
          }
        }
      },
      {
        "message": "Et le prix ?",
        "expected": {
          "classification": {
            "primaryIntent": "price_inquiry",
            "purchaseStage": "none",
            "shouldNotifySales": false
          },
          "policy": {
            "nextBestAction": "answer_price_directly_then_one_soft_next_question",
            "mustAnswer": ["price"]
          },
          "response": {
            "mustInclude": ["43 000", "86 000"],
            "mustExclude": ["guerit", "guerison totale", "soigne definitivement"],
            "maxRepeatedSentencesFromPreviousAssistant": 1
          }
        }
      }
    ]
  },
